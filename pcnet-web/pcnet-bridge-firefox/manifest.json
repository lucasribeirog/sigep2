{
  "manifest_version": 3,
  "name": "Nexus PCNet Bridge",
  "version": "0.2.27.0",
  "description": "Bridge do Nexus para PCNet: sessão gerenciada, automações de FAV, consulta e ações do Aceite, download de anexos e visualização de BO/REDS.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nexus-pcnet-bridge@local",
      "strict_min_version": "115.0",
      "update_url": "https://nexus-laudos-dev.onrender.com/downloads/pcnet-bridge-updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabHide",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.pcnet.mg.gov.br/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://nexus-laudos-dev.onrender.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Nexus PCNet Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pcnet.mg.gov.br/*"
      ],
      "js": [
        "content-pcnet.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://nexus-laudos-dev.onrender.com/*"
      ],
      "js": [
        "content-nexus.js"
      ],
      "run_at": "document_start"
    }
  ]
}
